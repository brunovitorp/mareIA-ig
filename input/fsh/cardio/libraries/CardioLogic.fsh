// Fonte L1: Metodologia §7.7.3.4 e §7.7.3.6. L2: 6-decision-logic.
Instance: CardioLogic
InstanceOf: Library
Usage: #definition
* status = #active
* experimental = false
* name = "CardioLogic"
* title = "Lógica de Suporte à Decisão — CardioRemoto"
* description = "Biblioteca de suporte à decisão clínica com regras de estratificação em 3 faixas (Verde, Amarelo, Vermelho), 4 níveis de alerta e periodicidade."
* type = http://terminology.hl7.org/CodeSystem/library-type#logic-library
