@startuml
title Atores e Papéis — CardioRemoto (UFPB / HULW)
skinparam shadowing false
skinparam defaultFontName Helvetica

left to right direction

actor "Paciente com DM/HAS" as Paciente
actor "Técnico de Coleta / Telessaúde" as Tecnico
actor "Médica Endocrinologista / Cardiologista" as Medico
actor "Nutricionista Multiprofissional" as Nutri
actor "Gestor do Serviço de Telessaúde" as Gestor
entity "Dispositivos IoT ANVISA" as IoT
entity "Sistema AGHUX (EBSERH)" as AGHUX

package "Plataforma mareIA — CardioRemoto" {
  usecase "Realizar automonitoramento IoT" as UC1
  usecase "Triagem clínica e antropometria" as UC2
  usecase "Avaliar alertas de risco cardiovascular" as UC3
  usecase "Realizar teleconsulta especializada" as UC4
  usecase "Orientação nutricional personalizada" as UC5
  usecase "Monitorar indicadores de controle (HbA1c/PA)" as UC6
  usecase "Sincronizar dados com prontuário hospitalar" as UC7
}

Paciente --> UC1
IoT --> UC1
Tecnico --> UC2
Medico --> UC3
Medico --> UC4
Nutri --> UC5
Gestor --> UC6
AGHUX --> UC7
@enduml
